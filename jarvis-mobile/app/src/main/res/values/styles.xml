<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/jarvis_bg</item>
        <item name="android:statusBarColor">@color/jarvis_bg</item>
        <item name="android:windowBackground">@color/jarvis_bg</item>
        <item name="android:textColorPrimary">@color/jarvis_text</item>
        <item name="android:textColorSecondary">@color/jarvis_text_secondary</item>
        <item name="android:colorBackground">@color/jarvis_bg</item>
    </style>

    <!-- Card Style -->
    <style name="CardStyle">
        <item name="android:background">@color/jarvis_panel</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- Button Style -->
    <style name="ButtonStyle" parent="android:Widget.Material.Button">
        <item name="android:textColor">@color/jarvis_text</item>
        <item name="android:background">@color/jarvis_accent_pink</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <!-- Text Styles -->
    <style name="TextLarge">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/jarvis_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/jarvis_text</item>
    </style>

    <style name="TextSmall">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/jarvis_text_secondary</item>
    </style>
</resources>